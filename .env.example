# --- Kalshi (create an API key at kalshi.com -> Account -> API keys) ---
# The key ID (a UUID) and the path to the RSA private key file Kalshi gives you.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# --- Polymarket ---
# Private key of the Polygon wallet that holds your USDC.
# If you trade through the Polymarket web UI, export the key from the site
# (Settings -> Export private key) and ALSO set the funder address below.
POLYMARKET_PRIVATE_KEY=
# Your Polymarket proxy/funder wallet address (the address shown in your
# Polymarket profile). Leave blank if trading straight from an EOA.
POLYMARKET_FUNDER_ADDRESS=
# 1 = email/Magic login proxy wallet, 2 = browser-wallet proxy, 0 = plain EOA
POLYMARKET_SIGNATURE_TYPE=1
